# Salin jadi .env (file .env tidak ikut git). Semua di bawah adalah konfigurasi, bukan mode tes.

# Alamat server peta. 127.0.0.1 = hanya bisa dibuka dari laptop ini.
LISTEN_ADDR=127.0.0.1:8765
# Folder halaman peta, relatif dari folder bff/
WEB_DIR=../web

# TownshipDB (dev dulu). Disarankan user read-only yang hanya boleh EXEC dbo.usp_DT_R_ComplaintMap_List.
# Boleh juga ditulis gaya Laravel: DB_HOST=<ip>\SQLOPERATIONS (kalau DB_PORT diisi, nama instance diabaikan).
DB_HOST=
DB_PORT=
DB_DATABASE=TownshipDB
DB_USERNAME=
DB_PASSWORD=
# Isi hanya kalau koneksi ditolak karena enkripsi/sertifikat:
# DB_ENCRYPT=true
# DB_TRUST_CERT=true

# IDX_M_Area Alam Sutera. Kosong = semua area (peta tetap hanya menampilkan titik di dalam batas Alam Sutera).
AREA_ID=1

# Ambil perubahan tiap N detik; muat penuh tiap N menit.
POLL_SECONDS=15
FULL_RELOAD_MINUTES=10
# Keluhan selesai/ditolak yang masih ditampilkan (hari ke belakang).
FINISHED_DAYS=7
